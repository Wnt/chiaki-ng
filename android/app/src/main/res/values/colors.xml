<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="primary">#162d50</color>
    <color name="primary_dark">#000128</color>
    <color name="accent">#ffaaee</color>
    <color name="on_primary">#ffffff</color>
    <color name="on_secondary">#000000</color>

    <!-- Readable on the light AppTheme surface; overridden for dark in
         values-night/colors.xml. See attr colorTextLink. -->
    <color name="text_link">#0D47A1</color>
    <!-- Readable on an always-dark surface (StreamTheme is not DayNight). -->
    <color name="text_link_dark">#82B1FF</color>

    <!-- "Linked" tag on the main console list (PLE-338); readable on the light
         AppTheme surface, overridden for dark in values-night/colors.xml. See
         attr colorLinkedIndicator. -->
    <color name="linked_indicator">#146C2E</color>

    <color name="stream_text">@android:color/white</color>
    <color name="stream_background">@android:color/black</color>
    <color name="stream_overlay_background">#77000000</color>
    <color name="stream_control_dock_background">#E61C1B1F</color>
    <color name="stream_control_dock_stroke">#55FFFFFF</color>
    <color name="stream_quality_good">#2E7D32</color>
    <color name="stream_quality_fair">#F9A825</color>
    <color name="stream_quality_poor">#C62828</color>
    <color name="stream_quality_unknown">#616161</color>
    <color name="stream_quit">#FFFFB4AB</color>

    <color name="control_primary">#22ffffff</color>
    <color name="control_pressed">#88ffffff</color>

    <color name="item_delete_background">#B71C1C</color>
</resources>

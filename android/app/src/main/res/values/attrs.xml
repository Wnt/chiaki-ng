<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="drawableIdle" format="reference" />
    <attr name="drawablePressed" format="reference" />

    <!-- Text-safe role for links and text buttons on AppTheme, with explicit
         light/dark values in colors.xml / values-night/colors.xml so it
         cannot regress to a static color that only reads in one mode. -->
    <attr name="colorTextLink" format="color" />

    <!-- Semantic "linked console" green for the main console list (PLE-338), with
         explicit light/dark values in colors.xml / values-night/colors.xml so it
         cannot regress to a static color that only reads in one mode. -->
    <attr name="colorLinkedIndicator" format="color" />

    <declare-styleable name="ButtonView">
        <attr name="drawableIdle" />
        <attr name="drawablePressed" />
        <attr name="drawableFitCenter" format="boolean" />
    </declare-styleable>

    <declare-styleable name="AnalogStickView">
        <attr name="radius" format="dimension" />
        <attr name="handleRadius" format="dimension" />
        <attr name="drawableBase" format="reference" />
        <attr name="drawableHandle" format="reference" />
    </declare-styleable>

    <declare-styleable name="TouchpadView">
        <attr name="drawableIdle" />
        <attr name="drawablePressed" />
    </declare-styleable>
</resources>